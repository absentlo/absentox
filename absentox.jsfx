desc:ABSENToX
options:no_meter
in_pin:none
out_pin:Left
out_pin:Right

slider1:wave=0<0,1,0.001>-Wave
slider2:detune=14<0,50,0.1>-Detune
slider3:sub=0.25<0,1,0.001>-Sub
slider4:noise=0.04<0,1,0.001>-Noise
slider5:wow_rate=0.4<0.05,8,0.01:log>-Wow Rate
slider6:wow_depth=10<0,100,0.1>-Wow Depth
slider7:cutoff=2500<40,18000,1:log>-Cutoff
slider8:reso=0.1<0,1,0.001>-Resonance
slider9:fenv=0.25<-1,1,0.001>-Filter Env
slider10:atk_ms=350<1,8000,1:log>-Attack
slider11:dec_ms=1200<5,8000,1:log>-Decay
slider12:sus=0.75<0,1,0.001>-Sustain
slider13:rel_ms=1800<5,12000,1:log>-Release
slider14:drive=0.2<0,1,0.001>-Drive
slider15:ch_rate=0.6<0.05,6,0.01:log>-Chorus Rate
slider16:ch_mix=0.35<0,1,0.001>-Chorus Mix
slider17:dl_time=420<20,1500,1:log>-Delay Time
slider18:dl_fb=0.35<0,0.9,0.001>-Delay Feedback
slider19:dl_mix=0.18<0,1,0.001>-Delay Mix
slider20:rv_size=1.2<0.4,2,0.001>-Reverb Size
slider21:rv_decay=6<0.5,30,0.01:log>-Reverb Decay
slider22:rv_tone=0.55<0,1,0.001>-Reverb Tone
slider23:rv_shim=0.1<0,1,0.001>-Reverb Shimmer
slider24:rv_mix=0.45<0,1,0.001>-Reverb Mix
slider25:eq_low=0<-12,12,0.1>-EQ Low
slider26:eq_mid=0<-12,12,0.1>-EQ Mid
slider27:eq_high=0<-12,12,0.1>-EQ High
slider28:out_db=0<-36,6,0.1>-Output
slider29:off_osc=0<0,1,1{On,Off}>-OSC
slider30:off_wow=0<0,1,1{On,Off}>-WOW
slider31:off_flt=0<0,1,1{On,Off}>-FILTER
slider32:off_env=0<0,1,1{On,Off}>-ENVELOPE
slider33:off_drv=0<0,1,1{On,Off}>-DRIVE
slider34:off_cho=0<0,1,1{On,Off}>-CHORUS
slider35:off_dly=0<0,1,1{On,Off}>-DELAY
slider36:off_rev=0<0,1,1{On,Off}>-REVERB
slider37:off_eq=0<0,1,1{On,Off}>-EQ
slider38:off_out=0<0,1,1{On,Off}>-OUT

@init
ext_noinit = 1; // keep reverb tails and held notes when playback starts
TWO_PI = 2 * $pi;

memtop = 0;
function alloc(n) local(p) ( p = memtop; memtop += n; p; );

// ---- voices
NV = 6;
V_ST = 0;   // 0 off, 1 attack, 2 decay/sustain, 3 release
V_NOTE = 1; V_VEL = 2; V_ENV = 3;
V_PC = 4; V_PA = 5; V_PB = 6; V_PS = 7; // phases: centre, left, right, sub
V_IC = 8; V_IA = 9; V_IB = 10; V_IS = 11; // phase increments
V_L1 = 12; V_L2 = 13; V_R1 = 14; V_R2 = 15; // filter state
V_A1 = 16; V_A2 = 17; V_A3 = 18; // filter coefficients
VS = 20;
voices = alloc(NV * VS);

function blep(t, dt)
(
  t < dt ? ( t /= dt; t + t - t * t - 1; ) :
  t > 1 - dt ? ( t = (t - 1) / dt; t * t + t + t + 1; ) : 0;
);

// saw minus a half-cycle-shifted saw is a square, so Wave morphs saw -> square
function osc(p, dt) local(s, q)
(
  s = 2 * p - 1 - blep(p, dt);
  wave > 0 ? (
    q = p + 0.5; q >= 1 ? q -= 1;
    s -= wave * (2 * q - 1 - blep(q, dt));
  );
  s;
);

function note_on(n, vel) local(v, best, low, score)
(
  // same note first, then a free voice, then the quietest (released before held)
  best = voices; low = 1000000000; v = voices;
  loop(NV,
    score = v[V_ST] == 0 ? -1 : v[V_NOTE] == n ? -2 : v[V_ENV] + (v[V_ST] < 3 ? 1 : 0);
    score < low ? ( low = score; best = v; );
    v += VS;
  );
  // a stolen voice keeps its level and filter state so it does not click
  best[V_ST] == 0 ? (
    best[V_ENV] = best[V_L1] = best[V_L2] = best[V_R1] = best[V_R2] = 0;
    // one shared start phase: unrelated phases would change the level of every note at low Detune
    best[V_PC] = best[V_PA] = best[V_PB] = rand(1); best[V_PS] = 0;
  );
  best[V_ST] = 1; best[V_NOTE] = n; best[V_VEL] = 0.35 + 0.65 * vel / 127;
  ctl = 0; // compute this voice's pitch and filter before its first sample
);

function note_off(n) local(v)
(
  v = voices;
  loop(NV,
    v[V_ST] && v[V_ST] < 3 && (n < 0 || v[V_NOTE] == n) ? v[V_ST] = 3;
    v += VS;
  );
);

// ---- effects helpers
function tap(b, n, w, d) local(p, i, f)
(
  p = w - d; p < 0 ? p += n;
  i = p | 0; f = p - i;
  b[i] * (1 - f) + b[i + 1 >= n ? 0 : i + 1] * f;
);

// b[n] holds this allpass's write position
function ap(x, b, n) local(w, d, u)
(
  w = b[n]; d = b[w];
  u = x + 0.6 * d;
  b[w] = u;
  w += 1; b[n] = w >= n ? 0 : w;
  d - 0.6 * u;
);

function bq(x, c, s) local(y)
(
  y = c[0] * x + s[0];
  s[0] = c[1] * x - c[3] * y + s[1];
  s[1] = c[2] * x - c[4] * y;
  y;
);

// RBJ cookbook. type: 0 low shelf, 1 peak, 2 high shelf
function eq_set(c, type, f, db) local(a, w, cs, al, sq, a0)
(
  a = 10 ^ (db / 40); w = TWO_PI * f / srate; cs = cos(w);
  al = sin(w) / sqrt(2); sq = 2 * sqrt(a) * al;
  type == 0 ? (
    a0 = (a + 1) + (a - 1) * cs + sq;
    c[0] = a * ((a + 1) - (a - 1) * cs + sq) / a0;
    c[1] = 2 * a * ((a - 1) - (a + 1) * cs) / a0;
    c[2] = a * ((a + 1) - (a - 1) * cs - sq) / a0;
    c[3] = -2 * ((a - 1) + (a + 1) * cs) / a0;
    c[4] = ((a + 1) + (a - 1) * cs - sq) / a0;
  ) : type == 1 ? (
    a0 = 1 + al / a;
    c[0] = (1 + al * a) / a0;
    c[1] = -2 * cs / a0;
    c[2] = (1 - al * a) / a0;
    c[3] = c[1];
    c[4] = (1 - al / a) / a0;
  ) : (
    a0 = (a + 1) - (a - 1) * cs + sq;
    c[0] = a * ((a + 1) + (a - 1) * cs + sq) / a0;
    c[1] = -2 * a * ((a - 1) + (a + 1) * cs) / a0;
    c[2] = a * ((a + 1) + (a - 1) * cs - sq) / a0;
    c[3] = 2 * ((a - 1) - (a + 1) * cs) / a0;
    c[4] = ((a + 1) - (a - 1) * cs - sq) / a0;
  );
);

// ---- buffers (sized from srate, so @init re-running on a rate change is enough)
chn = ceil(0.03 * srate); chl = alloc(chn); chr = alloc(chn);
dn = ceil(1.6 * srate); dbl = alloc(dn); dbr = alloc(dn);
dcur = dl_time * 0.001 * srate;

as = srate / 44100;
apn0 = ceil(142 * as); apn1 = ceil(379 * as); apn2 = ceil(151 * as); apn3 = ceil(353 * as);
apb0 = alloc(apn0 + 1); apb1 = alloc(apn1 + 1); apb2 = alloc(apn2 + 1); apb3 = alloc(apn3 + 1);

rn = ceil(0.15 * srate) + 16; // longest line at Size 2, plus modulation
rbuf = alloc(8 * rn);
rlen = alloc(8); rg = alloc(8); rz = alloc(8); rx = alloc(8);
rmod = 0.00018 * srate;
rsz = rv_size;

shw = ceil(0.08 * srate); shn = shw + 2; shb = alloc(shn);

eqc = alloc(15); eqs = alloc(12);

memset(0, 0, memtop);
freembuf(memtop);
rlen[0] = 0.0383; rlen[1] = 0.0363; rlen[2] = 0.0465; rlen[3] = 0.0510;
rlen[4] = 0.0544; rlen[5] = 0.0593; rlen[6] = 0.0658; rlen[7] = 0.0717;

pb = 0; ctl = 0; pend = 0;
act = 0; duck = 0; fade = 1 / (0.005 * srate);

// ---- UI table. Stored outside the DSP memory, in its own block.
ROW_N = 8; // slider, name, format, min, max, default, log, last value drawn
ptab = alloc(ROW_N * 64);
freembuf(memtop);
np = 0;
g_redraw = 1;
function entry(sl, name, fmt, mn, mx, def, lg) local(e)
(
  e = ptab + np * ROW_N;
  e[0] = sl; e[1] = name; e[2] = fmt; e[3] = mn; e[4] = mx; e[5] = def; e[6] = lg;
  np += 1;
);
function c_paper() ( gfx_set(0.95, 0.94, 0.92); );
function c_card() ( gfx_set(0.90, 0.89, 0.86); );
function c_ink() ( gfx_set(0.27, 0.27, 0.27); );
function c_soft() ( gfx_set(0.62, 0.61, 0.59); );
// built from filled discs because they draw rounder than gfx_arc: disc, cover the unused
// part with the section colour, inner disc, then round the two ends
function ring(cx, cy, r, w, a0, a1) local(n, i, a, b, sp, big, mid)
(
  gfx_circle(cx, cy, r, 1, 1);
  sp = 6.2832 - (a1 - a0); n = ceil(sp); big = (r + 2) / cos(sp / n / 2);
  mid = r - w / 2;
  c_card();
  i = 0;
  loop(n,
    a = a1 + sp * i / n; b = a1 + sp * (i + 1) / n;
    gfx_triangle(cx, cy, cx + sin(a) * big, cy - cos(a) * big, cx + sin(b) * big, cy - cos(b) * big);
    i += 1;
  );
  gfx_circle(cx, cy, r - w, 1, 1);
  g_on ? c_ink() : c_soft();
  gfx_circle(cx + sin(a0) * mid, cy - cos(a0) * mid, w / 2, 1, 1);
  gfx_circle(cx + sin(a1) * mid, cy - cos(a1) * mid, w / 2, 1, 1);
);
// three close lines, so the stroke is solid at every angle
function pointer(cx, cy, a, r0, r1) local(dx, dy, nx, ny, o)
(
  dx = sin(a); dy = -cos(a); nx = -dy; ny = dx; o = -0.5;
  loop(3,
    gfx_line(cx + nx * o + dx * r0, cy + ny * o + dy * r0, cx + nx * o + dx * r1, cy + ny * o + dy * r1, 1);
    o += 0.5;
  );
);
// row breaks keep their width in knobs and their group count in the min and max slots;
// headers keep their width in min, their switch in default and their knob count in log
function next_row() ( row_e = ptab + np * ROW_N; entry(-1, 0, 0, 0, 0, 0, 0); );
function head(name, off) ( group_e = ptab + np * ROW_N; entry(0, name, 0, 0, 0, off, 0); row_e[4] += 1; );
function knob(sl, name, fmt, mn, mx, def, lg)
(
  entry(sl, name, fmt, mn, mx, def, lg);
  row_e[3] += 1; group_e[3] += 1; group_e[6] += 1;
);

next_row();
head("OSC", 29);
knob(1, "Wave", "%.2f", 0, 1, 0, 0);
knob(2, "Detune", "%.1f ct", 0, 50, 14, 0);
knob(3, "Sub", "%.2f", 0, 1, 0.25, 0);
knob(4, "Noise", "%.2f", 0, 1, 0.04, 0);
head("WOW", 30);
knob(5, "Rate", "%.2f Hz", 0.05, 8, 0.4, 1);
knob(6, "Depth", "%.1f ct", 0, 100, 10, 0);
head("FILTER", 31);
knob(7, "Cutoff", "%.0f Hz", 40, 18000, 2500, 1);
knob(8, "Reso", "%.2f", 0, 1, 0.1, 0);
knob(9, "Env", "%+.2f", -1, 1, 0.25, 0);
next_row();
head("ENVELOPE", 32);
knob(10, "Attack", "%.0f ms", 1, 8000, 350, 1);
knob(11, "Decay", "%.0f ms", 5, 8000, 1200, 1);
knob(12, "Sustain", "%.2f", 0, 1, 0.75, 0);
knob(13, "Release", "%.0f ms", 5, 12000, 1800, 1);
head("DRIVE", 33);
knob(14, "Fuzz", "%.2f", 0, 1, 0.2, 0);
row_e[3] += 0.5; group_e[3] += 0.5; // one knob is too narrow for the title and its button
head("CHORUS", 34);
knob(15, "Rate", "%.2f Hz", 0.05, 6, 0.6, 1);
knob(16, "Mix", "%.2f", 0, 1, 0.35, 0);
head("DELAY", 35);
knob(17, "Time", "%.0f ms", 20, 1500, 420, 1);
knob(18, "Feedback", "%.2f", 0, 0.9, 0.35, 0);
knob(19, "Mix", "%.2f", 0, 1, 0.18, 0);
next_row();
head("REVERB", 36);
knob(20, "Size", "%.2f", 0.4, 2, 1.2, 0);
knob(21, "Decay", "%.1f s", 0.5, 30, 6, 1);
knob(22, "Tone", "%.2f", 0, 1, 0.55, 0);
knob(23, "Shimmer", "%.2f", 0, 1, 0.1, 0);
knob(24, "Mix", "%.2f", 0, 1, 0.45, 0);
head("EQ", 37);
knob(25, "Low 200", "%+.1f dB", -12, 12, 0, 0);
knob(26, "Mid 1k", "%+.1f dB", -12, 12, 0, 0);
knob(27, "High 5k", "%+.1f dB", -12, 12, 0, 0);
head("OUT", 38);
knob(28, "Level", "%.1f dB", -36, 6, 0, 0);

@block
// everything is derived here, so UI drags and automation need no @slider section
// Envelope off is a plain gate: short fades only, so notes still do not click
atk_inc = 1 / ((off_env ? 3 : atk_ms) * 0.001 * srate);
dec_co = exp(-6.9 / ((off_env ? 5 : dec_ms) * 0.001 * srate));
rel_co = exp(-6.9 / ((off_env ? 5 : rel_ms) * 0.001 * srate));
sus_v = off_env ? 1 : sus;
det_ratio = 2 ^ (detune / 1200);
fk = 2 - 1.96 * reso;
drv_g = 1 + drive * drive * 40;
drv_out = 1 / (1 + drive);
ch_inc = ch_rate / srate;
dl_target = dl_time * 0.001 * srate;
rv_damp = 1 - exp(-TWO_PI * 800 * 2 ^ (rv_tone * 4.3) / srate);
i = 0;
loop(8, rg[i] = 10 ^ (-3 * rlen[i] * rv_size / rv_decay); i += 1; );
// one bit per active section. A Mix at 0 counts as off: it costs no CPU and its memory gets cleared
mask = !off_osc + !off_wow * 2 + !off_flt * 4 + !off_env * 8 + !off_drv * 16
  + (!off_cho && ch_mix > 0) * 32 + (!off_dly && dl_mix > 0) * 64 + (!off_rev && rv_mix > 0) * 128
  + (!off_eq && (eq_low != 0 || eq_mid != 0 || eq_high != 0)) * 256 + !off_out * 512;
mask & 256 ? (
  eq_set(eqc, 0, 200, eq_low);
  eq_set(eqc + 5, 1, 1000, eq_mid);
  eq_set(eqc + 10, 2, 5000, eq_high);
);
out_g = 10 ^ (out_db / 20);

sidx = 0;
pend = midirecv(mofs, m1, m2, m3);

@sample
// ---- section switches apply only while the output is faded out, so toggling never clicks
mask != act ? (
  duck = max(0, duck - fade);
  duck == 0 ? (
    // a section coming back starts empty, or it would replay the sound it froze with
    mask & 32 && !(act & 32) ? memset(chl, 0, 2 * chn);
    mask & 64 && !(act & 64) ? ( memset(dbl, 0, 2 * dn); dlp_l = dlp_r = 0; );
    mask & 128 && !(act & 128) ? (
      memset(apb0, 0, apn0 + apn1 + apn2 + apn3 + 4);
      memset(rbuf, 0, 8 * rn); memset(rz, 0, 8); memset(shb, 0, shn);
    );
    act = mask;
    ctl = 0;
  );
) : duck = min(1, duck + fade);

// ---- MIDI, sample-accurate
while (pend && mofs <= sidx) (
  mst = m1 & 0xF0;
  mst == 0x90 && m3 > 0 ? note_on(m2, m3) :
  mst == 0x80 || mst == 0x90 ? note_off(m2) :
  mst == 0xB0 && (m2 == 123 || m2 == 120) ? note_off(-1) :
  mst == 0xE0 ? ( pb = (m3 * 128 + m2 - 8192) / 4096; ctl = 0; ); // +/- 2 semitones
  pend = midirecv(mofs, m1, m2, m3);
);
sidx += 1;

// ---- pitch and filter update every 32 samples, to stay cheap
ctl -= 1;
ctl < 0 ? (
  ctl = 31;
  wp1 += 32 * wow_rate / srate; wp1 >= 1 ? wp1 -= 1;
  wp2 += 32 * wow_rate * 0.37 / srate; wp2 >= 1 ? wp2 -= 1;
  // two unrelated sines, so the wobble never settles into an obvious cycle
  wow = act & 2 ? wow_depth * 0.01 * (sin(TWO_PI * wp1) + 0.4 * sin(TWO_PI * wp2)) / 1.4 : 0;
  v = voices;
  loop(NV,
    v[V_ST] ? (
      hz = 440 * 2 ^ ((v[V_NOTE] - 69 + pb + wow) / 12);
      inc = hz / srate;
      v[V_IC] = inc; v[V_IA] = inc * det_ratio; v[V_IB] = inc / det_ratio; v[V_IS] = inc * 0.5;
      act & 4 ? (
        fc = max(20, min(cutoff * 2 ^ (fenv * 5 * v[V_ENV]), srate * 0.45));
        fg = tan($pi * fc / srate);
        fa = 1 / (1 + fg * (fg + fk));
        v[V_A1] = fa; v[V_A2] = fg * fa; v[V_A3] = fg * fg * fa;
      );
    );
    v += VS;
  );
);

// ---- voices
sl = sr = 0;
nzl = (rand(2) - 1) * noise;
nzr = (rand(2) - 1) * noise;
v = voices;
loop(NV,
  st = v[V_ST];
  st ? (
    e = v[V_ENV];
    st == 1 ? (
      e += atk_inc;
      e >= 1 ? ( e = 1; v[V_ST] = 2; );
    ) : st == 2 ? (
      e = sus_v + (e - sus_v) * dec_co;
    ) : (
      e *= rel_co;
      e < 0.0001 ? ( e = 0; v[V_ST] = 0; );
    );
    v[V_ENV] = e;

    act & 1 ? (
      pc = v[V_PC] + v[V_IC]; pc >= 1 ? pc -= 1; v[V_PC] = pc;
      pa = v[V_PA] + v[V_IA]; pa >= 1 ? pa -= 1; v[V_PA] = pa;
      pbb = v[V_PB] + v[V_IB]; pbb >= 1 ? pbb -= 1; v[V_PB] = pbb;
      ps = v[V_PS] + v[V_IS]; ps >= 1 ? ps -= 1; v[V_PS] = ps;

      oc = osc(pc, v[V_IC]);
      os = sub > 0 ? sub * sin(TWO_PI * ps) : 0;
      xl = (oc + osc(pa, v[V_IA])) * 0.5 + os + nzl;
      xr = (oc + osc(pbb, v[V_IB])) * 0.5 + os + nzr;

      act & 4 ? (
        // TPT state-variable lowpass, stable at any cutoff and resonance
        a1 = v[V_A1]; a2 = v[V_A2]; a3 = v[V_A3];
        c1 = v[V_L1]; c2 = v[V_L2];
        t3 = xl - c2; t1 = a1 * c1 + a2 * t3; xl = c2 + a2 * c1 + a3 * t3;
        v[V_L1] = 2 * t1 - c1; v[V_L2] = 2 * xl - c2;
        c1 = v[V_R1]; c2 = v[V_R2];
        t3 = xr - c2; t1 = a1 * c1 + a2 * t3; xr = c2 + a2 * c1 + a3 * t3;
        v[V_R1] = 2 * t1 - c1; v[V_R2] = 2 * xr - c2;
      );
      g = e * v[V_VEL] * 0.3;
      sl += xl * g;
      sr += xr * g;
    );
  );
  v += VS;
);

// ---- fuzz. shortcut: no oversampling, so high notes alias at full Fuzz; oversample if it sounds harsh
act & 16 ? (
  x = sl * drv_g; sl = x / (1 + abs(x)) * drv_out;
  x = sr * drv_g; sr = x / (1 + abs(x)) * drv_out;
);

// ---- chorus
act & 32 ? (
  chl[cw] = sl; chr[cw] = sr;
  cp += ch_inc; cp >= 1 ? cp -= 1;
  wl = tap(chl, chn, cw, (0.013 + 0.005 * sin(TWO_PI * cp)) * srate);
  wr = tap(chr, chn, cw, (0.013 + 0.005 * cos(TWO_PI * cp)) * srate);
  sl += (wl - sl) * ch_mix;
  sr += (wr - sr) * ch_mix;
  cw += 1; cw >= chn ? cw = 0;
);

// ---- delay: crossed feedback, darkened on every repeat
act & 64 ? (
  dcur += (dl_target - dcur) * 0.0002; // glide on time changes, like tape, instead of clicking
  wl = tap(dbl, dn, dw, dcur);
  wr = tap(dbr, dn, dw, dcur);
  dlp_l += (wl - dlp_l) * 0.35;
  dlp_r += (wr - dlp_r) * 0.35;
  dbl[dw] = sl + dlp_r * dl_fb;
  dbr[dw] = sr + dlp_l * dl_fb;
  dw += 1; dw >= dn ? dw = 0;
  sl += wl * dl_mix;
  sr += wr * dl_mix;
);

// ---- reverb: 8-line feedback delay network, fed by the signal plus an octave-up copy
act & 128 ? (
  il = sl; ir = sr;
  // shortcut: one octave only, no endless climb; inside the reverb loop it ran away, so that needs a limiter
  rv_shim > 0 ? (
    shb[sw] = (sl + sr) * 0.5;
    sp += 1 / shw; sp >= 1 ? sp -= 1;
    sq = sp + 0.5; sq >= 1 ? sq -= 1;
    d1 = sw - ((1 - sp) * shw | 0) - 1; d1 < 0 ? d1 += shn;
    d2 = sw - ((1 - sq) * shw | 0) - 1; d2 < 0 ? d2 += shn;
    sh = shb[d1] * (1 - abs(2 * sp - 1)) + shb[d2] * (1 - abs(2 * sq - 1));
    sh *= rv_shim;
    il += sh; ir += sh;
    sw += 1; sw >= shn ? sw = 0;
  );
  il = ap(ap(il, apb0, apn0), apb1, apn1) + 0.000000000000001; // the offset keeps the tail out of slow denormals
  ir = ap(ap(ir, apb2, apn2), apb3, apn3) + 0.000000000000001;

  rsz += (rv_size - rsz) * 0.0002;
  rl += 0.31 / srate; rl >= 1 ? rl -= 1;
  ma = rmod * sin(TWO_PI * rl);
  mb = rmod * cos(TWO_PI * rl);
  rsum = 0; i = 0;
  loop(8,
    y = tap(rbuf + i * rn, rn, rw, rlen[i] * srate * rsz + (i & 1 ? ma : mb));
    z = rz[i] + (y - rz[i]) * rv_damp;
    rz[i] = z;
    y = z * rg[i];
    rx[i] = y; rsum += y;
    i += 1;
  );
  rsum *= 0.25; // Householder feedback: x - (2/N) * sum(x)
  i = 0;
  loop(8,
    rbuf[i * rn + rw] = rx[i] - rsum + (i & 1 ? ir : il);
    i += 1;
  );
  rw += 1; rw >= rn ? rw = 0;

  wl = (rx[0] + rx[2] + rx[4] + rx[6]) * 0.3;
  wr = (rx[1] + rx[3] + rx[5] + rx[7]) * 0.3;
  sl += (wl - sl) * rv_mix;
  sr += (wr - sr) * rv_mix;
);

// ---- EQ
act & 256 ? (
  sl = bq(bq(bq(sl, eqc, eqs), eqc + 5, eqs + 2), eqc + 10, eqs + 4);
  sr = bq(bq(bq(sr, eqc, eqs + 6), eqc + 5, eqs + 8), eqc + 10, eqs + 10);
);

// hard ceiling: the last line of defence for speakers and ears
g = act & 512 ? out_g * duck : 0;
spl0 = max(-1, min(1, sl * g));
spl1 = max(-1, min(1, sr * g));

@gfx 660 312
// this runs on the UI thread: use only g_ variables, never the ones @sample writes
gfx_clear = -1; // keep the last frame, so an idle window costs almost nothing
g_now = time_precise();
g_btn = mouse_cap & 3;
g_press = g_btn && !g_last;
// a long gap between frames means the window was closed and may have lost its picture
g_dirty = g_redraw || g_btn || g_last || gfx_w != g_w || gfx_h != g_h || g_now - g_prev > 0.25;
g_prev = g_now;
!g_dirty ? (
  // automation and presets move knobs and switches too
  g_i = 0;
  loop(np,
    g_e = ptab + g_i * ROW_N;
    g_k = g_e[0] > 0 ? g_e[0] : g_e[0] == 0 ? g_e[5] : 0;
    g_k && slider(g_k) != g_e[7] ? g_dirty = 1;
    g_i += 1;
  );
);

!g_btn && g_drag ? ( slider_automate(2 ^ (g_drag - 1), 1); g_drag = 0; );

g_dirty ? (
  g_redraw = 0; g_w = gfx_w; g_h = gfx_h;
  g_mg = 3; g_top = 28; g_hd = 20;
  g_rh = (gfx_h - g_top - g_mg) / 3;
  gfx_setfont(1, "Arial", 12);
  g_lh = gfx_texth;
  gfx_setfont(2, "Arial", 12, 'b');
  gfx_setfont(3, "Arial", 16, 'b');

  c_paper(); gfx_rect(0, 0, gfx_w, gfx_h);

  c_ink();
  gfx_setfont(3);
  gfx_x = 8; gfx_y = 14 - gfx_texth / 2; gfx_drawstr("ABSENToX");

  gfx_setfont(1);
  g_s = "Ctrl: fine    Right-click: reset";
  gfx_measurestr(g_s, g_tw, g_th);
  c_soft(); gfx_x = gfx_w - g_mg - 4 - g_tw; gfx_y = 14 - g_lh / 2; gfx_drawstr(g_s);

  g_y = g_top - g_rh; g_i = 0;
  loop(np,
    g_e = ptab + g_i * ROW_N;
    g_sl = g_e[0];
    g_sl < 0 ? (
      g_y += g_rh; g_x = 0;
      g_cell = (gfx_w - g_mg * (g_e[4] + 1)) / g_e[3];
    ) : g_sl == 0 ? (
      g_x += g_mg;
      g_gw = g_e[3] * g_cell;
      g_kc = g_gw / g_e[6];
      g_off = g_e[5];
      c_card(); gfx_rect(g_x, g_y, g_gw, g_rh - g_mg);

      // on/off switch, top right of the section: a filled circle is on, a hollow one is off
      g_bw = 18; g_bh = 18; g_bx = g_x + g_gw - g_bw - 2; g_by = g_y + 1;
      g_press && !(mouse_cap & 2) && mouse_x >= g_bx && mouse_x < g_bx + g_bw && mouse_y >= g_by && mouse_y < g_by + g_bh ? (
        slider(g_off) = !slider(g_off);
        slider_automate(2 ^ (g_off - 1));
        slider_automate(2 ^ (g_off - 1), 1);
      );
      g_on = !slider(g_off);
      g_e[7] = slider(g_off);

      gfx_setfont(2);
      g_on ? c_ink() : c_soft();
      gfx_x = g_x + 5; gfx_y = g_y + (g_hd - gfx_texth) / 2; gfx_drawstr(g_e[1]);
      g_dx = floor(g_bx + g_bw - 8); g_dy = floor(g_y + g_hd / 2);
      gfx_circle(g_dx, g_dy, 5, 1, 1);
      !g_on ? ( c_card(); gfx_circle(g_dx, g_dy, 3, 1, 1); );
    ) : (
      gfx_setfont(1);
      g_mn = g_e[3]; g_mx = g_e[4];
      g_zt = g_y + g_hd; g_zh = g_rh - g_mg - g_hd;
      g_v = slider(g_sl);
      g_n = g_e[6] ? log(g_v / g_mn) / log(g_mx / g_mn) : (g_v - g_mn) / (g_mx - g_mn);

      g_press && mouse_x >= g_x && mouse_x < g_x + g_kc && mouse_y >= g_zt && mouse_y < g_zt + g_zh ? (
        mouse_cap & 2 ? (
          slider(g_sl) = g_e[5];
          slider_automate(2 ^ (g_sl - 1));
          slider_automate(2 ^ (g_sl - 1), 1);
        ) : (
          g_drag = g_sl; g_dn = g_n; g_ly = mouse_y;
        );
      );
      g_drag == g_sl && mouse_y != g_ly ? (
        // knobs turn with vertical drags: 200 px is the full range, 2000 px with Ctrl
        g_dn = max(0, min(1, g_dn + (g_ly - mouse_y) / (mouse_cap & 4 ? 2000 : 200)));
        g_ly = mouse_y;
        slider(g_sl) = g_e[6] ? g_mn * (g_mx / g_mn) ^ g_dn : g_mn + (g_mx - g_mn) * g_dn;
        slider_automate(2 ^ (g_sl - 1));
      );
      g_v = slider(g_sl);
      g_e[7] = g_v;
      g_n = g_e[6] ? log(g_v / g_mn) / log(g_mx / g_mn) : (g_v - g_mn) / (g_mx - g_mn);

      g_r = max(4, min(gfx_w / 10.5 * 0.31, (g_zh - 2 * g_lh - 8) / 2));
      g_cx = g_x + g_kc / 2;
      g_cy = g_zt + g_zh / 2 - 1;

      g_r = floor(g_r); g_cx = floor(g_cx); g_cy = floor(g_cy); // whole pixels keep the discs symmetric
      // range runs from 7 to 5 o'clock; symmetric ranges (EQ, Env) grow from the top
      g_a = -2.356 + 4.712 * g_n;
      g_a0 = g_mn == -g_mx ? 0 : -2.356;
      g_on ? c_ink() : c_soft();
      ring(g_cx, g_cy, g_r, 3, min(g_a0, g_a), max(g_a0, g_a));
      gfx_circle(g_cx, g_cy, g_r * 0.7, 1, 1);
      c_paper();
      pointer(g_cx, g_cy, g_a, g_r * 0.2, g_r * 0.7);

      // text last: the ring's cover reaches slightly past the ring
      g_on ? c_ink() : c_soft();
      gfx_measurestr(g_e[1], g_tw, g_th);
      gfx_x = g_cx - g_tw / 2; gfx_y = g_cy - g_r - g_lh - 3; gfx_drawstr(g_e[1]);
      sprintf(#g_val, g_e[2], g_v);
      gfx_measurestr(#g_val, g_tw, g_th);
      gfx_x = g_cx - g_tw / 2; gfx_y = g_cy + g_r + 3; gfx_drawstr(#g_val);

      g_x += g_kc;
    );
    g_i += 1;
  );
);
g_last = g_btn;
